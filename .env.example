# ==============================================================================
# WooCommerce E2E Monitor Configuration (wp-monitor)
# ==============================================================================

# Base URL of the target store (including https:// without trailing slash)
SITE_URL=https://your-store.example

# Test customer credentials (Customer role recommended)
TEST_USER=your_test_customer
TEST_PASS=replace-with-a-local-secret

# Numeric WooCommerce product post ID to add to cart
TEST_PRODUCT_ID=12345

# Custom page paths (optional, defaults to standard WooCommerce endpoints)
ACCOUNT_PATH=/my-account/
CART_PATH=/cart/
CHECKOUT_PATH=/checkout/

# Telegram Notification Settings (optional for local runs, required for alerts)
TG_TOKEN=
TG_CHAT=

# WAF / Cloudflare bypass secret key (sent in X-Monitor-Key request header)
MONITOR_KEY=

# Global timeout in milliseconds (default: 30000)
TIMEOUT_MS=30000

# Browser execution mode (true: headless, false: visible browser for debugging)
HEADLESS=true

# Quiet mode (true: only send Telegram alert on failure; suppress success notifications)
QUIET_ON_SUCCESS=false
