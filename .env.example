# ==============================================================================
# پیکربندی سیستم مانیتورینگ خودکار ووکامرس (WooCommerce E2E Monitor)
# تمام متغیرها را بر اساس محیط و سایت خود در فایل .env مقداردهی کنید.
# ==============================================================================

# آدرس پایه سایت فروشگاه (همراه با https:// و بدون اسلش پایانی)
SITE_URL=https://your-store.example

# اطلاعات لاگین کاربر تستی مانیتورینگ در ووکامرس (نقش مشتری / Customer)
TEST_USER=your_test_customer
TEST_PASS=replace-with-a-local-secret

# شناسه محصول تستی در ووکامرس (شناسه عددی پست ووکامرس جهت افزودن مستقیم به سبد)
TEST_PRODUCT_ID=12345

# تنظیمات ارسال گزارش به تلگرام (اختیاری در محیط لوکال ولی الزامی برای گزارش‌دهی خودکار)
# دریافت توکن از @BotFather و دریافت Chat ID از @userinfobot یا ارسال به یک گروه/کانال
TG_TOKEN=
TG_CHAT=

# کلید اختصاصی عبور از فایروال / WAF / کلودفلر (در هدر X-Monitor-Key ارسال می‌شود)
MONITOR_KEY=

# حداکثر زمان انتظار برای لود صفحات و المان‌ها (میلی‌ثانیه - پیش‌فرض 30000 یعنی ۳۰ ثانیه)
TIMEOUT_MS=30000

# حالت اجرای مرورگر (true برای اجرای پس‌زمینه بدون UI، false برای مشاهده زنده مرورگر)
HEADLESS=true

# عدم ارسال پیام تلگرام در صورت موفقیت کامل سناریوها (true = فقط هنگام خطا پیام بفرست)
QUIET_ON_SUCCESS=false
